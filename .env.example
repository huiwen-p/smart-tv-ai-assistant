# =================================================================
# SMART TV POD - CONFIGURATION TEMPLATE (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế
# =================================================================

# 1. IP của Smart TV (Xiaomi Android TV) trong mạng LAN (kèm hoặc không kèm cổng 5555)
TARGET_DEVICE_IP=10.88.88.163

# 2. Khóa Google Gemini Flash API (để trống sẽ tự động fallback sang từ điển FTS5 Offline)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash
USE_AI_RESOLVER=true

# 3. Cấu hình giọng nói tiếng Việt Microsoft Edge-TTS
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=-10%

# 4. Cấu hình chân GPIO Raspberry Pi
GPIO_BUTTON_PIN=18
GPIO_LED_GREEN=23
GPIO_LED_RED=24

# 5. Đường dẫn CSDL SQLite cục bộ
DB_PATH=data/context_db.sqlite

